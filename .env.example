# Copy to .env and fill in. Any OpenAI-compatible server works.
LLM_BASE_URL=https://<llm server>/v1
LLM_API_KEY=
LLM_MODEL=qwen3-14b
# Leave empty to use LLM_BASE_URL
EMBED_BASE_URL=
EMBED_MODEL=bge-m3
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3
# 1 = append /no_think (Qwen3). Use 0 for other models.
NO_THINK=1
# live: call APIs, fall back to cache on failure / offline: cache only
CACHE_MODE=live
TIMEOUT=60
# Optional: kordoc engine location (default: ./node_modules/kordoc/dist/cli.js and `node` on PATH)
# KORDOC_CLI=
# KORDOC_NODE=
